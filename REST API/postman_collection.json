		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Register User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.tokens && jsonData.tokens.access) {",
									"    pm.collectionVariables.set('accessToken', jsonData.tokens.access);",
									"    pm.collectionVariables.set('refreshToken', jsonData.tokens.refresh);",
									"    console.log('Access token updated from registration.');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"farhan_dev\",\n    \"email\": \"farhan@example.com\",\n    \"password\": \"SecurePass123!\",\n    \"password_confirm\": \"SecurePass123!\",\n    \"first_name\": \"Farhan\",\n    \"last_name\": \"Khan\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "register", ""]
						},
						"description": "Registers a new user and returns JWT access & refresh tokens."
					},
					"response": []
				},
				{
					"name": "Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.tokens && jsonData.tokens.access) {",
									"    pm.collectionVariables.set('accessToken', jsonData.tokens.access);",
									"    pm.collectionVariables.set('refreshToken', jsonData.tokens.refresh);",
									"    console.log('Access token updated from login.');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"farhan_dev\",\n    \"password\": \"SecurePass123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login", ""]
						},
						"description": "Logs in user using username or email and returns JWT tokens."
					},
					"response": []
				},
				{
					"name": "Refresh Access Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access) {",
									"    pm.collectionVariables.set('accessToken', jsonData.access);",
									"    console.log('Access token refreshed.');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/refresh/",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "refresh", ""]
						},
						"description": "Obtain a fresh access token using the refresh token."
					},
					"response": []
				},
				{
					"name": "Get Current User Profile (Protected)",
					"request": {
						"method": "GET",
						"header": [
